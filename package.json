{
  "name": "deepcause",
  "version": "0.1.0",
  "description": "Zero-dependency error serializer that walks the full cause chain",
  "keywords": [
    "error",
    "cause",
    "serialize",
    "chain",
    "logging",
    "root-cause",
    "debugging"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "check": "npm run build && publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.4",
    "publint": "^0.2.12",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
